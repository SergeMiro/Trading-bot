# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# LLM (MiniMax via Chutes.ai)
LLM_API_KEY=your_chutes_api_key
LLM_BASE_URL=https://llm.chutes.ai/v1
LLM_MODEL=openai/MiniMaxAI/MiniMax-M2.1-TEE

# SEC EDGAR
SEC_USER_AGENT=YourName your@email.com

# IBKR
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Trading settings
MIN_MARKET_CAP=500000000
MAX_MONITORING_LINES=100
SCORE_THRESHOLD_BUY=70
SCORE_THRESHOLD_HOLD=50
TARGET_GAIN=0.08
STOP_LOSS=0.05
MAX_HOLD_DAYS=7
RISK_PER_TRADE=0.02
