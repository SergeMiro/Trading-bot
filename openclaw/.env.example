# ═══════════════════════════════════════════════════════════════
# Trading Bot v2 — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=trading_bot
POSTGRES_USER=trading_bot
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trading_bot:CHANGE_ME_STRONG_PASSWORD@localhost:5432/trading_bot

# ─── SEC EDGAR ───────────────────────────────────────────────
# SEC requires a valid User-Agent with contact email
SEC_USER_AGENT=trading-bot your_real_email@example.com

# ─── Interactive Brokers (IBKR) ──────────────────────────────
# TWS ports: 7497 = paper trading, 7496 = live trading
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID_SETUP=1
IBKR_CLIENT_ID_PREMARKET=2
IBKR_CLIENT_ID_TRADE=3
IBKR_CLIENT_ID_MONITOR=4

# ─── Anthropic Claude (used by OpenClaw) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Telegram Bot ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_USER_ID=123456789

# ─── OpenClaw Gateway ────────────────────────────────────────
OPENCLAW_WEBHOOK_SECRET=your_webhook_secret_here
OPENCLAW_WEBHOOK_URL=http://localhost:3000/webhook/sec-events

# ─── Trading Parameters ─────────────────────────────────────
TARGET_GAIN=0.09
STOP_LOSS=0.05
MAX_HOLD_DAYS=7
RISK_PER_TRADE=0.02
MAX_CONCURRENT_POSITIONS=3
MAX_MONITORING_LINES=100
SCORE_BUY=70
SCORE_HOLD=50

# ─── Scoring Thresholds (adjustable) ────────────────────────
# These can be auto-tuned by the self-learning system

# ─── Grafana (optional) ─────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASS
GRAFANA_PORT=3001

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO
